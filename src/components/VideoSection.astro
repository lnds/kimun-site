---
import { t, pathInLang, type Lang } from '../i18n/ui';
import { links } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
const video = links.video[lang];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
---

<section class="section" id="video">
  <div class="container video-grid">
    <div class="section-head">
      <p class="eyebrow">{tt('video.eyebrow')}</p>
      <h2>{tt('video.title')}</h2>
      <p>{tt('video.body')}</p>
      <p class="other">
        <a href={`${pathInLang('/', otherLang)}#video`}>{tt('video.other')} <span aria-hidden="true">→</span></a>
      </p>
    </div>
    <video controls preload="metadata" poster={video.poster} width="1920" height="1080">
      <source src={video.src} type="video/mp4" />
      <p>{tt('video.unsupported')} <a href={video.src}>MP4</a></p>
    </video>
  </div>
</section>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-12);
    align-items: center;
  }
  .section-head {
    margin-bottom: 0;
  }
  .other {
    margin-top: var(--space-4) !important;
    font-size: 0.95rem !important;
    font-weight: 600;
  }
  video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 880px) {
    .video-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  }
</style>
