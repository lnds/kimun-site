---
import { t, pathInLang, type Lang } from '../i18n/ui';
import InstallCommand from './InstallCommand.astro';
import { links } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
---

<section class="cta">
  <div class="container cta-inner">
    <h2>{tt('cta.title')}</h2>
    <p>{tt('cta.body')}</p>
    <InstallCommand lang={lang} />
    <div class="cta-row">
      <a class="btn" href={pathInLang('/get-started', lang)}>
        {tt('hero.cta.start')}
      </a>
      <a class="btn secondary" href={links.github.kimun} rel="noopener">
        {tt('cta.docs')}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-16) 0;
    border-top: 1px solid var(--border);
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .cta h2 {
    margin-bottom: var(--space-3);
  }
  .cta p {
    color: var(--fg-muted);
    max-width: 56ch;
    margin-bottom: var(--space-6);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
