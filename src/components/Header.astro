---
import { t, pathInLang, type Lang } from '../i18n/ui';
import { links } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);

const home = pathInLang('/', lang);
const navItems = [
  { href: `${home}#features`, key: 'nav.features' as const },
  { href: `${home}#video`, key: 'nav.video' as const },
  { href: `${home}#commands`, key: 'nav.commands' as const },
  { href: pathInLang('/get-started', lang), key: 'nav.start' as const },
  { href: pathInLang('/about', lang), key: 'nav.name' as const },
];

const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const otherPath = pathInLang(Astro.url.pathname.replace(/^\/en/, '') || '/', otherLang);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={pathInLang('/', lang)} class="brand" aria-label="Kimün">
      <img src="/madu-icon-64.png" alt="" width="34" height="34" class="mark" />
      <span class="brand-name">kimün</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {navItems.map(({ href, key }) => (
          <li><a href={href}>{tt(key)}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="icon-link theme-toggle"
        data-theme-toggle
        aria-label={tt('theme.toggle')}
        title={tt('theme.toggle')}
      >
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.4v2.4M12 19.2v2.4M2.4 12h2.4M19.2 12h2.4M5.2 5.2l1.7 1.7M17.1 17.1l1.7 1.7M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7" />
          </g>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
          />
        </svg>
      </button>
      <a
        href={links.github.kimun}
        class="icon-link"
        aria-label="GitHub"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.07 11.07 0 0 1 5.8 0c2.21-1.49 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.8 1.18 1.83 1.18 3.08 0 4.42-2.7 5.38-5.27 5.66.42.36.79 1.07.79 2.16v3.2c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          />
        </svg>
      </a>
      <a href={otherPath} class="lang-switch" aria-label={`Switch to ${otherLang}`}>
        {otherLang === 'en' ? 'EN' : 'ES'}
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(8px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .brand:hover { text-decoration: none; }
  .mark { display: block; }

  /* The toggle shows the theme you would switch TO, not the current one. */
  .theme-toggle {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  .theme-toggle .i-sun { display: none; }
  .theme-toggle .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .i-sun { display: block; }
    :root:not([data-theme='light']) .theme-toggle .i-moon { display: none; }
  }
  :root[data-theme='dark'] .theme-toggle .i-sun { display: block; }
  :root[data-theme='dark'] .theme-toggle .i-moon { display: none; }
  :root[data-theme='light'] .theme-toggle .i-sun { display: none; }
  :root[data-theme='light'] .theme-toggle .i-moon { display: block; }
  .primary-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }
  .primary-nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .primary-nav a {
    color: var(--fg-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .primary-nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--fg-muted);
    width: 32px;
    height: 32px;
    border-radius: var(--radius);
  }
  .icon-link:hover {
    color: var(--fg);
    background: var(--bg-subtle);
    text-decoration: none;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }
  .lang-switch:hover {
    color: var(--fg);
    background: var(--bg-subtle);
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .header-inner {
      flex-wrap: wrap;
    }
    .header-actions { margin-left: auto; }
    /* flex-basis, not width: the base rule's `flex: 1` zeroes the basis. */
    .primary-nav {
      order: 3;
      flex: 1 0 100%;
      min-width: 0;
      justify-content: flex-start;
    }
    .primary-nav ul {
      gap: var(--space-4);
      flex-wrap: nowrap;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
    }
  }
</style>

<script>
  // The toggle flips to the opposite of what is currently shown, taking the
  // OS preference as the starting point when nothing was chosen before.
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.getAttribute('data-theme') ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('kimun-theme', next);
    } catch (e) {
      /* nothing to persist to; the choice still applies for this page */
    }
  });
</script>
