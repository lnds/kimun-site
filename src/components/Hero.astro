---
import { t, pathInLang, type Lang } from '../i18n/ui';
import { links } from '../lib/links';
import { output } from '../lib/output';
import Terminal from './Terminal.astro';
import InstallCommand from './InstallCommand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
---

<section class="hero backdrop">
  <div class="container hero-grid">
    <div class="hero-text">
      <a class="pill" href="#video">
        <span class="pill-dot" aria-hidden="true"></span>
        {tt('hero.pill')} <span aria-hidden="true">→</span>
      </a>
      <h1>
        <span>{tt('hero.title.line1')}</span>{' '}
        <span class="warm">{tt('hero.title.line2')}</span>
      </h1>
      <p class="lead">{tt('hero.lead')}</p>

      <InstallCommand lang={lang} />

      <div class="cta-row">
        <a class="btn" href={pathInLang('/get-started', lang)}>
          {tt('hero.cta.start')}
        </a>
        <a class="btn secondary" href="#video">
          {tt('hero.cta.video')}
        </a>
        <a class="text-link" href={links.github.kimun} rel="noopener">
          GitHub <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="why-name">
        <a href={pathInLang('/about', lang)}>{tt('hero.whyName')}</a>
      </p>
    </div>

    <div class="hero-side">
      <img class="madu" src="/madu.png" alt={tt('hero.madu.alt')} width="720" height="959" />
      <Terminal title="km score" html={output.score} note={tt('hero.real')} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-24);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-12);
    align-items: center;
  }
  .hero-side {
    position: relative;
    min-width: 0;
    padding-top: 7.5rem;
  }
  /* Madu sits on the window, looking over what it printed. */
  .madu {
    position: absolute;
    top: -1.5rem;
    right: 1rem;
    width: 11.5rem;
    height: auto;
    z-index: 2;
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.35));
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-4);
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--fg);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .pill:hover {
    border-color: var(--accent-soft);
    text-decoration: none;
  }
  .pill-dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent-soft);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1.08;
    text-wrap: balance;
    letter-spacing: -0.04em;
    font-weight: 800;
    margin-bottom: var(--space-6);
  }
  h1 .warm {
    color: var(--accent);
  }
  .lead {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 46ch;
    margin-bottom: var(--space-8);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
  .text-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--fg);
  }
  .text-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .why-name {
    font-size: 0.88rem;
    margin: var(--space-6) 0 0;
  }
  .why-name a {
    color: var(--fg-muted);
    border-bottom: 1px dotted var(--fg-subtle);
  }
  .why-name a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero { padding-block: var(--space-8) var(--space-12); }
    .hero-side { padding-top: 6rem; }
    .madu { width: 9rem; top: -1rem; }
  }
</style>
