---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import { docGroups, docPath, docsOf } from '../lib/docs';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
const docs = await docsOf(lang);
---

<Base lang={lang} title={`${tt('docs.title')} · Kimün`} description={tt('docs.lead')}>
  <div class="page backdrop">
    <div class="container">
      <header>
        <p class="eyebrow">{tt('docs.eyebrow')}</p>
        <h1>{tt('docs.title')}</h1>
        <p class="lead">{tt('docs.lead')}</p>
      </header>

      <div class="groups">
        {docGroups.map(({ title, slugs }) => (
          <section>
            <h2>{tt(title)}</h2>
            <dl>
              {slugs.map((slug) => {
                const { title: name, description } = docs.get(slug)!.data;
                return (
                  <div class="row">
                    <dt>
                      <a href={docPath(slug, lang)} class:list={{ cmd: name.startsWith('km ') }}>
                        {name}
                      </a>
                    </dt>
                    <dd>{description}</dd>
                  </div>
                );
              })}
            </dl>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .groups {
    columns: 3 18rem;
    column-gap: var(--space-8);
  }
  section {
    break-inside: avoid;
    margin-bottom: var(--space-8);
  }
  h2 {
    font-size: 1.05rem;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 2px solid var(--accent-soft);
  }
  dl {
    margin: 0;
  }
  .row {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }
  dt a {
    font-weight: 600;
  }
  dt a.cmd {
    font-family: var(--font-mono);
    font-size: 0.92em;
    font-weight: 500;
  }
  dd {
    margin: var(--space-1) 0 0;
    color: var(--fg-muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }
</style>
