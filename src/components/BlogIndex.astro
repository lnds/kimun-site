---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n/ui';
import { formatDate, postPath, postSlug, postsOf } from '../lib/blog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tt = t(lang);
const posts = await postsOf(lang);
---

<Base lang={lang} title={`${tt('blog.title')} · Kimün`} description={tt('blog.lead')}>
  <div class="page backdrop">
    <div class="container">
      <header>
        <p class="eyebrow">{tt('blog.eyebrow')}</p>
        <h1>{tt('blog.title')}</h1>
        <p class="lead">{tt('blog.lead')}</p>
      </header>

      <ol class="posts">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date, lang)}
            </time>
            <h2>
              <a href={postPath(postSlug(post, lang), lang)}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Base>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 48rem;
  }
  li {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-subtle);
  }
  h2 {
    font-size: 1.5rem;
    margin: var(--space-2) 0;
  }
  h2 a {
    color: var(--fg);
  }
  h2 a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  p {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
